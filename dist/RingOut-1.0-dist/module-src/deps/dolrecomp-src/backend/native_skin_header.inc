    "/* ---- NATIVE SKIN helpers (work/skin-native, transform.py) -- experiment, not shipped ----\n"
    " * Preconditions are checked so that each native access is EXACTLY what the inlined fast path in cpu.h\n"
    " * (dolrecomp_psq_load_inline_r / dolrecomp_psq_store_inline_r / mem_read16/32) would do for this access. */\n"
    "#define NAT_RAM DOLRECOMP_RAM_ARG(ctx)\n"
    "/* Every helper is always inlined and never instrumented: a STATIC function that keeps a profile entry is named\n"
    " * \"<source file path>;<name>\" in the .profdata, which would put the training machine's paths into the profiles\n"
    " * this project ships. Inlined, uninstrumented helpers have no entry at all (and are too small to need one). */\n"
    "#define NAT_FN static inline __attribute__((always_inline, no_profile_instrument_function))\n"
    "NAT_FN bool nat_in_ram(u32 ea, u32 size) { return (u32)(ea - GC_RAM_BASE) <= GC_MAIN_RAM_SIZE - size; }\n"
    "NAT_FN bool nat_skin_ok(CPUState* ctx) {\n"
    "    if (!(ctx->msr & 0x00002000u)) return false;                                 /* MSR.FP */\n"
    "    if (!(ctx->hid2 & PPC_HID2_PSE) || !(ctx->hid2 & PPC_HID2_LSQE)) return false; /* non-indexed psq allowed */\n"
    "    if (((ctx->gqr[0] >> 16) & 7u) != 0u || (ctx->gqr[0] & 7u) != 0u) return false; /* GQR0 float load+store */\n"
    "    if (((ctx->gqr[6] >> 16) & 7u) != 7u || ((ctx->gqr[7] >> 16) & 7u) != 7u) return false; /* s16 loads */\n"
    "    return true;\n"
    "}\n"
    "NAT_FN f64 nat_qscale(const CPUState* ctx, unsigned q) {\n"
    "    const s32 scale = ((s32)(((ctx->gqr[q] >> 24) & 0x3Fu) << 26)) >> 26;\n"
    "    union { u64 u; f64 d; } m; m.u = (u64)(u32)(1023 - scale) << 52; return m.d;  /* 2^-scale, as cpu.h */\n"
    "}\n"
    "/* float pair load, GQR0 type 0: aligned + in RAM checked by the iteration guard */\n"
    "NAT_FN void nat_psq_l_0(u8* ram, u32 ea, f64* a, f64* b) {\n"
    "    const u8* h = ram + (ea - GC_RAM_BASE);\n"
    "#if defined(DOLRECOMP_PSQ_SIMD_ON)\n"
    "    dolrecomp_psq_load2(h, a, b);\n"
    "#else\n"
    "    *a = dolrecomp_psq_single_value(read_be32(h)); *b = dolrecomp_psq_single_value(read_be32(h + 4));\n"
    "#endif\n"
    "}\n"
    "/* s16 pair load with the GQR's scale: same arithmetic as cpu.h's quantised inline path (type 7) */\n"
    "NAT_FN void nat_psq_l_s16(u8* ram, u32 ea, f64 m, f64* a, f64* b) {\n"
    "    const u8* h = ram + (ea - GC_RAM_BASE);\n"
    "    *a = (f64)(f32)((f64)(s16)read_be16(h) * m);\n"
    "    *b = (f64)(f32)((f64)(s16)read_be16(h + 2) * m);\n"
    "}\n"
    "#define NAT_PSQ_L(n, ea_, q) NAT_PSQ_L_##q(n, ea_)\n"
    "#define NAT_PSQ_L_0(n, ea_) nat_psq_l_0(NAT_RAM, (ea_), &nF##n, &nP##n)\n"
    "#define NAT_PSQ_L_6(n, ea_) nat_psq_l_s16(NAT_RAM, (ea_), nat_qscale(ctx, 6), &nF##n, &nP##n)\n"
    "#define NAT_PSQ_L_7(n, ea_) nat_psq_l_s16(NAT_RAM, (ea_), nat_qscale(ctx, 7), &nF##n, &nP##n)\n"
    "#define NAT_PSQ_ST(n, ea_) do { u32 nat_ea = (ea_); u8* h = NAT_RAM + (nat_ea - GC_RAM_BASE); \\\n"
    "    dolrecomp_clear_reservation(ctx, nat_ea); dolrecomp_journal_cached(ctx, h, 8u); \\\n"
    "    NAT_PSQ_ST2(h, nF##n, nP##n); } while (0)\n"
    "#if defined(DOLRECOMP_PSQ_SIMD_ON)\n"
    "#define NAT_PSQ_ST2(h, a, b) dolrecomp_psq_store2((h), (a), (b))\n"
    "#else\n"
    "#define NAT_PSQ_ST2(h, a, b) do { write_be32((h), dolrecomp_psq_single_bits(a)); write_be32((h) + 4, dolrecomp_psq_single_bits(b)); } while (0)\n"
    "#endif\n"
    "#define NAT_R16(ea_) read_be16(NAT_RAM + ((ea_) - GC_RAM_BASE))\n"
    "#define NAT_R32(ea_) read_be32(NAT_RAM + ((ea_) - GC_RAM_BASE))\n"
    "/* Per-iteration guard: every address the iteration touches, checked BEFORE any state changes. */\n"
    "NAT_FN bool nat_mtx_ok(u8* ram, u32 r0, u32 r4, u32 off) {\n"
    "    if (!nat_in_ram(r4 + off, 2u)) return false;\n"
    "    const u32 idx = (u32)(s32)(s16)read_be16(ram + (r4 + off - GC_RAM_BASE));\n"
    "    const u32 mtx = r0 + (dolrecomp_rotl32(idx, 6u) & 0xFFFFFFC0u);\n"
    "    return (mtx & 3u) == 0u && nat_in_ram(mtx, 48u);\n"
    "}\n"
    "NAT_FN bool nat_out_ok(u32 r3, u32 r5, u32 r6) {\n"
    "    return (r5 & 3u) == 0u && nat_in_ram(r5, 16u) && (r6 & 3u) == 0u && nat_in_ram(r6, 16u) &&\n"
    "           (r3 & 3u) == 0u && nat_in_ram(r3, 12u);\n"
    "}\n"
    "NAT_FN bool nat_iter_ok_L1(u8* ram, u32 r0, u32 r3, u32 r4, u32 r5, u32 r6) {\n"
    "    return nat_out_ok(r3, r5, r6) && nat_in_ram(r4, 16u) && nat_mtx_ok(ram, r0, r4, 14u);\n"
    "}\n"
    "NAT_FN bool nat_iter_ok_L2(u8* ram, u32 r0, u32 r3, u32 r4, u32 r5, u32 r6) {\n"
    "    return nat_out_ok(r3, r5, r6) && nat_in_ram(r4, 32u) && nat_mtx_ok(ram, r0, r4, 14u) && nat_mtx_ok(ram, r0, r4, 30u);\n"
    "}\n"
    "NAT_FN bool nat_iter_ok_L3(u8* ram, u32 r0, u32 r3, u32 r4, u32 r5, u32 r6) {\n"
    "    return nat_out_ok(r3, r5, r6) && nat_in_ram(r4, 48u) && nat_mtx_ok(ram, r0, r4, 14u) &&\n"
    "           nat_mtx_ok(ram, r0, r4, 30u) && nat_mtx_ok(ram, r0, r4, 46u);\n"
    "}\n"
    "/* loop 4 (weighted accumulation, CTR-driven inner loop): the matrix index is masked to 8 bits\n"
    " * (rlwinm r7,r7,6,18,25), and the outputs at r5/r6 are read and written (float pairs, GQR0). */\n"
    "NAT_FN bool nat_iter_ok_L4(u8* ram, u32 r0, u32 r3, u32 r4, u32 r5, u32 r6) {\n"
    "    (void)r3;\n"
    "    if (!nat_in_ram(r4, 16u) || (r5 & 3u) != 0u || !nat_in_ram(r5, 16u) || (r6 & 3u) != 0u || !nat_in_ram(r6, 16u))\n"
    "        return false;\n"
    "    const u32 idx = (u32)(s32)(s16)read_be16(ram + (r4 + 14u - GC_RAM_BASE));\n"
    "    const u32 mtx = r0 + (dolrecomp_rotl32(idx, 6u) & 0x00003FC0u);\n"
    "    return (mtx & 3u) == 0u && nat_in_ram(mtx, 48u);\n"
    "}\n"
    "/* ---- end NATIVE SKIN helpers ---- */\n"
    "\n"
