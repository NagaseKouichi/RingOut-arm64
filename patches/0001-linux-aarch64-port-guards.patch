From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: RingOut aarch64 port <local>
Subject: [PATCH] linux aarch64: guard x86-only fmod pin, --deck, PGO, glibc fallback

Against jackpoison-prog/RingOut v1.6.3 (ceda43f4).

Four first-party portability guards. This does not modify ModernGekko or the
vendored Dolphin runtime. Apply from the repo root:

  git apply --check patches/0001-linux-aarch64-port-guards.patch
  git apply patches/0001-linux-aarch64-port-guards.patch

---

index 54ceebd36cd88989b168cf1e98a5d4a5aadea6ec..d76cab294c38344a66672082f541c3363cee51b4 100644
--- a/DolRecomp/src/cpu/cpu.c
+++ b/DolRecomp/src/cpu/cpu.c
@@ -43,7 +43,9 @@
 // unnoticed because the shipped binary predates it and install(1) re-stamped its
 // mtime, so it looked current. The pin is only ever needed for the module, which
 // is the thing that gets dlopened on a Deck.
-#if defined(__linux__) && defined(__GLIBC__) && defined(MODULE_GAME_ID)
+// GLIBC_2.2.5 is the x86_64 fmod baseline. aarch64 glibc starts at 2.17 and
+// has no fmod@GLIBC_2.2.5, so an unguarded pin fails the module link.
+#if defined(__linux__) && defined(__GLIBC__) && defined(MODULE_GAME_ID) && defined(__x86_64__)
 __asm__(".symver fmod,fmod@GLIBC_2.2.5");
 #endif
 
diff --git a/dist/RingOut-1.0-dist/RingOut b/dist/RingOut-1.0-dist/RingOut
index 979a63b8f3cb199807d0938a337e265cf9c414c9..86f2d530bd69176b4ed419b22b7afbe812a56005 100755
--- a/dist/RingOut-1.0-dist/RingOut
+++ b/dist/RingOut-1.0-dist/RingOut
@@ -282,7 +282,8 @@ NEED_GLIBC=2.36
 host_glibc="$(ldd --version 2>/dev/null | head -1 | grep -oE '[0-9]+\.[0-9]+' | tail -1)"
 LOADER="$HERE/libc-fallback/ld-linux-x86-64.so.2"
 
-if [ -n "$host_glibc" ] && [ -x "$LOADER" ] && \
+# Bundled glibc + PT_INTERP is x86_64-only. aarch64 uses the host loader.
+if [ "$(uname -m)" = "x86_64" ] && [ -n "$host_glibc" ] && [ -x "$LOADER" ] && \
    [ "$(printf '%s\n%s\n' "$NEED_GLIBC" "$host_glibc" | sort -V | head -1)" != "$NEED_GLIBC" ]; then
     echo "Ring Out: host glibc $host_glibc is older than $NEED_GLIBC - using bundled glibc." >&2
     # $LIB_PATH, not $HERE/lib: on this path the bundled glibc genuinely has to
diff --git a/dist/RingOut-1.0-dist/module-src/deps/dolrecomp-src/cpu/cpu.c b/dist/RingOut-1.0-dist/module-src/deps/dolrecomp-src/cpu/cpu.c
index 54ceebd36cd88989b168cf1e98a5d4a5aadea6ec..d76cab294c38344a66672082f541c3363cee51b4 100644
--- a/dist/RingOut-1.0-dist/module-src/deps/dolrecomp-src/cpu/cpu.c
+++ b/dist/RingOut-1.0-dist/module-src/deps/dolrecomp-src/cpu/cpu.c
@@ -43,7 +43,9 @@
 // unnoticed because the shipped binary predates it and install(1) re-stamped its
 // mtime, so it looked current. The pin is only ever needed for the module, which
 // is the thing that gets dlopened on a Deck.
-#if defined(__linux__) && defined(__GLIBC__) && defined(MODULE_GAME_ID)
+// GLIBC_2.2.5 is the x86_64 fmod baseline. aarch64 glibc starts at 2.17 and
+// has no fmod@GLIBC_2.2.5, so an unguarded pin fails the module link.
+#if defined(__linux__) && defined(__GLIBC__) && defined(MODULE_GAME_ID) && defined(__x86_64__)
 __asm__(".symver fmod,fmod@GLIBC_2.2.5");
 #endif
 
diff --git a/dist/RingOut-1.0-dist/setup.sh b/dist/RingOut-1.0-dist/setup.sh
index bcc3539e52e26aa578c49a38abb44922a1e98a98..d8632123c9cd884ad4dccb760bb61c13f5fabeba 100755
--- a/dist/RingOut-1.0-dist/setup.sh
+++ b/dist/RingOut-1.0-dist/setup.sh
@@ -64,8 +64,18 @@ if [ -z "$ISO" ] || [ ! -f "$ISO" ]; then
     exit 1
 fi
 
+# Host ISA. --deck is an x86_64 Steam Deck compatibility mode; passing
+# -march=x86-64-v3 on aarch64 fails the compile instead of helping.
+HOST_ARCH="$(uname -m)"
 if [ "$DECK" = 1 ]; then
-    MARCH="x86-64-v3"
+    case "$HOST_ARCH" in
+        x86_64|amd64) MARCH="x86-64-v3" ;;
+        aarch64|arm64)
+            echo "error: --deck is for Steam Deck (x86_64). On $HOST_ARCH omit --deck." >&2
+            exit 1
+            ;;
+        *) MARCH="native" ;;
+    esac
 else
     MARCH="native"
 fi
@@ -479,7 +489,10 @@ echo "==> 3/$NSTAGES  Building the module"
 # regions. So: use the profile for THIS disc, and if there is not one, use none.
 PGO_ARGS=()
 PROFILE=""
-if "$CC" --version 2>&1 | grep -qi clang; then
+# Shipped .profdata files were trained on x86_64 modules. Feeding them to an
+# aarch64 clang is a mismatched profile (wrong CFG hashes) and is slower than
+# none. Train on this machine with --pgo instead.
+if "$CC" --version 2>&1 | grep -qi clang && { [ "$HOST_ARCH" = "x86_64" ] || [ "$HOST_ARCH" = "amd64" ]; }; then
     if [ -f "$HERE/module-src/profiles/$DISC_ID.profdata" ]; then
         PROFILE="$HERE/module-src/profiles/$DISC_ID.profdata"
     elif [ "$DISC_ID" = "GRSEPS" ] && [ -f "$HERE/module-src/profiles/GRSEAF.profdata" ]; then
